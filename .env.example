# PostgreSQL connection (local dev: database "siparis", see README)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/siparis

# API server
API_HOST=localhost
API_PORT=3000
LOG_LEVEL=info

# Vite dev server
WEB_PORT=5173

# Address guests open from the table QR codes (no trailing slash). To scan the codes with a
# phone on your Wi-Fi during development, use your computer's LAN address, e.g.
# http://192.168.1.20:5173
# PUBLIC_URL=http://localhost:5173

# Encrypts cafés' iyzico secret keys (32 random bytes, base64: `openssl rand -base64 32`).
# Needed to save iyzico keys; keep it safe, losing it means re-entering every café's keys.
# PAYMENT_SECRET_KEY=

# Production only (defaults shown; see docs/DEPLOY.md)
# CLIENT_IP_HEADER=x-real-ip
# WEB_DIR=../web/dist

# Auth (optional, defaults shown)
# SESSION_TTL_DAYS=30
# LOGIN_RATE_LIMIT=10

# Super-admin for `npm run admin:create` (production setup)
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=

# Uploaded images (local disk in development; relative to apps/api)
# UPLOAD_DIR=uploads
